CURRENT_SEASON=73
BBAPI_LOGIN=your-bbapi-login
BBAPI_CODE=your-bbapi-code
BB_PASSWORD=your-buzzerbeater-site-password

# New-world beta (separate from legacy BBAPI credentials)
BB_V1_CLIENT_ID=
BB_V1_CLIENT_SECRET=
BB_V1_REDIRECT_URI=http://127.0.0.1:5055/beta/oauth/callback
